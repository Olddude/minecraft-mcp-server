{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "target",
      "type": "promptString",
      "description": "Relative target file path",
      "default": ""
    }
  ],
  "configurations": [
    {
      "type": "bashdb",
      "request": "launch",
      "name": "[Debug] Shell",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/scripts/kill.sh",
      "args": [
        "3000"
      ],
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "[Debug] Server",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
