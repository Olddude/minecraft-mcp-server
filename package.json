{
  "name": "@olddude/minecraft-mcp",
  "version": "0.1.0",
  "main": "index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0",
  "bin": {
    "mcrcon": "bin/mcrcon",
    "minecraft-mcp": "index.js"
  },
  "types": "types.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olddude/minecraft-mcp-server.git"
  },
  "publishConfig": {
    "@olddude:registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "minecraft",
    "mcp",
    "server",
    "modelcontextprotocol",
    "mcrcon"
  ],
  "scripts": {
    "lint": "eslint . -c eslint.config.mjs --ignore-pattern dist",
    "lint:fix": "npm run lint -- --fix",
    "test:ci": "jest --detectOpenHandles --coverage",
    "test": "npm run test:ci -- --watch",
    "build:backend": "node -r dotenv/config src/backend/esbuild.config.mjs",
    "build:frontend": "node -r dotenv/config src/frontend/esbuild.config.mjs",
    "start:backend:debug": "node -r tsconfig-paths/register -r ts-node/register -r dotenv/config src/backend/index.ts",
    "start:backend:release": "node -r dotenv/config dist/backend/index.js",
    "start:frontend:debug": "node -r tsconfig-paths/register -r ts-node/register -r dotenv/config src/frontend/index.ts",
    "start:frontend:release": "node -r dotenv/config dist/frontend/index.js",
    "inspect:backend:debug": "npx @modelcontextprotocol/inspector --config mcp-inspector.config.json --server minecraft-backend-debug",
    "inspect:backend:release": "npx @modelcontextprotocol/inspector --config mcp-inspector.config.json --server minecraft-backend-release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "log4js": "^6.9.1",
    "swagger-ui-express": "^5.0.1",
    "vec3": "^0.1.8",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@modelcontextprotocol/inspector": "^0.16.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/log4js": "^0.0.33",
    "@types/nock": "^10.0.3",
    "@types/node": "^22.15.29",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/vec3": "^0.0.29",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "dotenv": "^16.5.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.14.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.25.4",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "nock": "^14.0.5",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0"
  }
}
